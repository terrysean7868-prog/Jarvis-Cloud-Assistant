###
# Jarvis Cloud Assistant - Environment Template
#
# Copy this file to `.env` for local development.
# For Render.com: set values in Render Dashboard (Environment section).
#
# IMPORTANT: Never commit real secrets.
###

# =====================
# Core mode
# =====================
# Render should be: true
JARVIS_CLOUD_MODE=false

# =====================
# Authentication (Render REQUIRED)
# =====================
# Render: set a long random value (or use render.yaml generateValue)
JARVIS_JWT_SECRET=
JARVIS_JWT_TTL_SECONDS=28800
JARVIS_JWT_ISSUER=jarvis

# =====================
# Remote PC Agent hub (Render REQUIRED if you want PC automation)
# =====================
JARVIS_AGENT_SHARED_SECRET=
JARVIS_DEFAULT_DEVICE_ID=primary
JARVIS_DEVICE_OWNER_USERNAME=

# =====================
# PC Agent (run on your Windows PC)
# =====================
# Point the agent at your server (Render backend URL or your local URL)
JARVIS_SERVER_URL=https://jarvis-cloud-assistant.onrender.com

# This device id will appear in /api/device/status and can be claimed by your user.
JARVIS_DEVICE_ID=primary

# Must match the server's JARVIS_AGENT_SHARED_SECRET
JARVIS_AGENT_SHARED_SECRET=

# Permissions (capabilities) - used for clear "No permission" responses
JARVIS_AGENT_ALLOW_APP_CONTROL=false
JARVIS_AGENT_ALLOW_EXECUTE_COMMAND=false
JARVIS_AGENT_ALLOW_FILE_OPS=false
JARVIS_AGENT_ALLOW_SCREEN=false
JARVIS_AGENT_ALLOW_SELF_UPDATE=false

# Optional: strict allowlist of action types the agent will execute
# Example: open_app,execute_command
JARVIS_AGENT_ACTION_ALLOWLIST=

# Optional: file sandbox for agent file ops
JARVIS_AGENT_PROJECT_ROOT=
JARVIS_AGENT_ALLOWED_PATHS=data,docs,src,modules

# =====================
# Database
# =====================
MONGODB_URI=
MONGODB_DB_NAME=jarvis_db

# =====================
# LLM provider
# =====================
# Set ONE provider key depending on LLM_PROVIDER.
LLM_PROVIDER=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# =====================
# Optional services
# =====================
OPENWEATHER_KEY=
TELEGRAM_TOKEN=

# =====================
# Google Speech-to-Text (server-side STT)
# =====================
# Required for:
# - /api/stt/google (frontend mobile fallback)
# - /api/voice/secure-transcribe (voice biometrics mode)
GOOGLE_SPEECH_ENABLED=false
GOOGLE_SPEECH_LANGUAGE_DEFAULT=en-US

# Provide ONE of the following credential formats (service account JSON):
# - GOOGLE_SPEECH_CREDENTIALS_JSON={"type":"service_account",...}
# - GOOGLE_SPEECH_CREDENTIALS_B64=BASE64_OF_JSON
GOOGLE_SPEECH_CREDENTIALS_JSON=
GOOGLE_SPEECH_CREDENTIALS_B64=

# =====================
# Server-side file sandbox (optional)
# =====================
JARVIS_ALLOWED_PATHS=src,modules,jarvis-frontend/src,docs,data

# =====================
# Frontend dev (optional)
# =====================
BACKEND_PORT=8000
FRONTEND_PORT=3000
DEFAULT_LANG=en
ENABLE_VOICE=1

# =====================
# Desktop (optional)
# =====================
# Used by scripts/jarvis_desktop/jarvis_web_shell.py when --url isn't provided.
# Can point at local or cloud.
JARVIS_SERVER_URL=http://127.0.0.1:18001

# =====================
# Auth storage + voice auth tuning
# =====================
# Use MongoDB as the authoritative auth store.
# Cloud deployments typically set this to true.
# Local development can keep it false to use file-based auth.
AUTH_USE_DB=false
# If true, registration/login fails when MongoDB is unavailable.
AUTH_REQUIRE_DB=false

# Transcript matching (more reliable than hashing alone)
VOICE_TEXT_SIMILARITY_THRESHOLD=0.75
VOICE_MAX_SAMPLES=5