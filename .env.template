# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/jarvis_db
MONGODB_DB_NAME=jarvis_db

# LLM Configuration
PRIMARY_MODEL=gpt-4
PRIMARY_API_KEY=your_openai_api_key
PRIMARY_ENDPOINT=https://api.openai.com/v1/chat/completions

BACKUP_MODEL=llama-3.1-8b-instant
BACKUP_API_KEY=your_groq_api_key
BACKUP_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# GitHub Configuration
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_token
GITHUB_REPO=your_username/your_repo
SSH_KEY=your_ssh_private_key
GIT_BRANCH=main
GIT_AUTO_SYNC=true

# Voice Recognition Settings
VOSK_MODEL=vosk-model-small-en-us
VOICE_LANGUAGE=en-US
VAD_SENSITIVITY=3
SILENCE_DURATION=0.5

# System Settings
DEBUG=false
LOG_LEVEL=INFO
AUTO_UPDATE=true
MAX_RETRIES=3
TIMEOUT=30

# Frontend Settings
PORT=3000
HOST=localhost
API_BASE_URL=/api
WS_BASE_URL=/ws

# Security Settings
ALLOWED_ORIGINS=*
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440

# Path Settings
ALLOWED_PATHS=modules,utils,jarvis-frontend/src,app.py,jarvis_brain.py,llm_adapter.py,executor.py,git_sync.py,run_jarvis.py,config.py,requirements.txt,README.md