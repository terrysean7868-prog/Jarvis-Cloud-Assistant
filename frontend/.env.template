###
# Jarvis Frontend - Environment Template (Create React App)
#
# Copy this file to: frontend/.env.local
# Then restart: npm start
#
# NOTE: CRA injects REACT_APP_* vars at build/start time.
#       If you change these, you must restart the dev server.
###

# Enable Google/secure server-side STT fallback (used for mobile and for voice biometrics mode)
REACT_APP_GOOGLE_SPEECH_ENABLED=false

# Wake session length after the wake word (minutes)
REACT_APP_WAKE_SESSION_MINUTES=15
