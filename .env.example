# =====================================
# JARVIS Cloud Assistant - Environment Variables
# Copy this to .env and fill in your values
# =====================================

# Server Configuration
PORT=8000
BACKEND_PORT=8000
HOST=0.0.0.0
MODE=development

# Database (MongoDB)
# Local default: mongodb://localhost:27017/jarvis
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/jarvis
MONGODB_URI=mongodb://localhost:27017/jarvis
MONGODB_DB_NAME=jarvis_db

# LLM / AI Models
PRIMARY_MODEL=gpt-4o-mini
PRIMARY_API_KEY=
PRIMARY_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=

BACKUP_MODEL=llama-3.1-8b-instant
BACKUP_API_KEY=
GROQ_API_KEY=
BACKUP_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# GitHub / Git Sync (optional)
GITHUB_REPO=
GITHUB_USERNAME=
GITHUB_TOKEN=
SSH_KEY=
GIT_BRANCH=main
GIT_AUTO_SYNC=true

# Voice Recognition (optional)
VOICE_LANGUAGE=en-US
VOSK_MODEL=vosk-model-small-en-us
VAD_SENSITIVITY=3
SILENCE_DURATION=0.5

# Render / Cloud Deployment (set automatically by Render)
# RENDER=true
# RENDER_SERVICE_ID=your-render-service-id
# RENDER_API_KEY=your-render-api-key

# System Settings
DEBUG=false
LOG_LEVEL=INFO
AUTO_UPDATE=true
MAX_RETRIES=3
TIMEOUT=30

# Security (optional)
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440

# API Keys (if using Telegram, Binance, etc.)
# TELEGRAM_TOKEN=your_token_here
# TELEGRAM_CHAT_ID=your_chat_id
# BINANCE_API_KEY=your_key
# BINANCE_SECRET=your_secret
# API_KEY=your_api_key
# API_SECRET=your_api_secret
# =========================================================
# JARVIS Environment Variables Template
# =========================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: DO NOT COMMIT .env FILE - it contains secrets!

# =========================================================
# MongoDB Configuration
# =========================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jarvis_db
MONGODB_DB_NAME=jarvis_db

# =========================================================
# GitHub Configuration (for auto-sync)
# =========================================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=username/Jarvis-Cloud-Assistant
GITHUB_USER=your_github_username
GITHUB_EMAIL=your_email@example.com

# =========================================================
# LLM API Keys (OpenAI, Groq, etc.)
# =========================================================
# Primary LLM Model (e.g., GPT-4)
PRIMARY_MODEL=gpt-4
PRIMARY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
PRIMARY_ENDPOINT=https://api.openai.com/v1/chat/completions

# Backup LLM Model (e.g., Llama via Groq)
BACKUP_MODEL=llama-3.1-8b-instant
BACKUP_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
BACKUP_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# =========================================================
# Frontend Configuration
# =========================================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =========================================================
# Bot Configuration
# =========================================================
ALLOWED_PATHS=modules,utils,jarvis-frontend/src,app.py,jarvis_brain.py,llm_adapter.py,executor.py,git_sync.py,run_jarvis.py,config.py,requirements.txt,README.md
AUTO_APPLY=true

# =========================================================
# Optional: Telegram Bot (if using)
# =========================================================
# TELEGRAM_BOT_TOKEN=your_telegram_token_here

# =========================================================
# Optional: Voice Configuration
# =========================================================
# VOICE_ENABLED=true
# MICROPHONE_DEVICE_ID=0

# =========================================================
# Optional: Logging & Debug
# =========================================================
# DEBUG=false
# LOG_LEVEL=INFO
