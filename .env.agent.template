###
# PC Agent environment template
# Copy to `.env.agent` on the Windows PC where you want actions (Notepad, etc.)
###

# Render backend URL
JARVIS_SERVER_URL=https://jarvis-cloud-assistant.onrender.com

# Device identity (match what you dispatch to; default flow uses primary)
JARVIS_DEVICE_ID=primary

# Must match Render backend env: JARVIS_AGENT_SHARED_SECRET
JARVIS_AGENT_SHARED_SECRET=

# Start restrictive; UI popup can grant at runtime.
JARVIS_AGENT_ALLOW_APP_CONTROL=false
JARVIS_AGENT_ALLOW_EXECUTE_COMMAND=false
JARVIS_AGENT_ALLOW_FILE_OPS=false
JARVIS_AGENT_ALLOW_SCREEN=false
JARVIS_AGENT_ALLOW_SELF_UPDATE=false

# Allow UI-approved runtime changes (recommended true)
JARVIS_AGENT_ALLOW_REMOTE_PERMISSION_CHANGES=true

# Persist approvals to this file (default is data/agent_permissions.json)
# JARVIS_AGENT_PERMISSIONS_FILE=
